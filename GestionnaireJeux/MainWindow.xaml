<Window x:Class="GestionnaireJeux.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GestionnaireJeux"
        Title="{Binding [AppTitle], Source={x:Static local:Loc.Instance}}"
        Icon="/Assets/app.ico"
        Width="1280" Height="840" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Carte d'un lecteur -->
        <DataTemplate x:Key="DriveCardTemplate" DataType="{x:Type local:DriveEntry}">
            <Border x:Name="Card" Width="236" Margin="8,0,8,10" Padding="15,12,15,12" CornerRadius="12"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5"
                    Cursor="Hand">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="16"
                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14.5"/>
                            <Run Text="{Binding VolumeLabel, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" FontSize="12.5"/>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding GamesText}" Margin="0,9,0,0" FontSize="13"/>
                    <Border Height="6" CornerRadius="3" Margin="0,9,0,0" Background="{Binding BarBrush}"
                            Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding SpaceText}" Margin="0,7,0,0" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedCardBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Ligne d'un jeu -->
        <DataTemplate x:Key="GameRowTemplate" DataType="{x:Type local:GameEntry}">
            <Border x:Name="Card" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Margin="8,0,8,8" Padding="12,10,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="180"/>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="214"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icône (ou initiale colorée en attendant) -->
                    <Grid Width="44" Height="44" VerticalAlignment="Center">
                        <Border CornerRadius="10" Background="{Binding PlatformTint}">
                            <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding PlatformBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="10" Background="{DynamicResource IconTileBrush}"
                                Visibility="{Binding Icon, Converter={StaticResource NullToVis}}">
                            <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,34,34" RadiusX="7" RadiusY="7"/>
                                </Image.Clip>
                            </Image>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}"/>
                        <TextBlock Text="{Binding InstallPathDisplay}" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding InstallPathDisplay}"/>
                        <TextBlock Text="{Binding NoteText}" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,3,0,0"
                                   Visibility="{Binding NoteText, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>

                    <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding PlatformTint}"
                            CornerRadius="11" Padding="9,3,10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding PlatformBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlatformLabel}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding PlatformBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2,7,3">
                        <TextBlock Text="{Binding DriveLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}"/>
                    </Border>

                    <TextBlock Grid.Column="4" Text="{Binding LastPlayedText}" Foreground="{DynamicResource TextDimBrush}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <TextBlock x:Name="SizeLabel" Grid.Column="5" Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"/>

                    <Grid Grid.Column="6" VerticalAlignment="Center">
                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Click="OpenFolder_Click"
                                    ToolTip="{Binding [OpenFolderTip], Source={x:Static local:Loc.Instance}}"/>
                            <Button Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Uninstall_Click"
                                    IsEnabled="{Binding CanUninstall}"
                                    ToolTip="{Binding [UninstallTip], Source={x:Static local:Loc.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [Uninstall], Source={x:Static local:Loc.Instance}}" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- En attente du désinstalleur externe -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource SpinnerTrack}"/>
                                <Ellipse Style="{StaticResource SpinnerArc}"/>
                            </Grid>
                            <TextBlock Text="{Binding [Waiting], Source={x:Static local:Loc.Instance}}" Foreground="{DynamicResource TextDimBrush}"
                                       Margin="8,0,12,0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource SecondaryButton}" Padding="11,5" Click="CancelWait_Click"
                                    Content="{Binding [Cancel], Source={x:Static local:Loc.Instance}}"
                                    ToolTip="{Binding [CancelWaitTip], Source={x:Static local:Loc.Instance}}"/>
                        </StackPanel>

                        <!-- Suppression en cours dans l'appli -->
                        <StackPanel HorizontalAlignment="Right" Width="190" VerticalAlignment="Center"
                                    Visibility="{Binding IsRemoving, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse Style="{StaticResource SpinnerTrack}"/>
                                    <Ellipse Style="{StaticResource SpinnerArc}"/>
                                </Grid>
                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource TextDimBrush}"/>
                            </StackPanel>
                            <ProgressBar Style="{StaticResource SlimProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,7,0,0"
                                         Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SizeIsApprox}" Value="True">
                    <Setter TargetName="SizeLabel" Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SizeBytes}" Value="{x:Null}">
                    <Setter TargetName="SizeLabel" Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
                    <Setter TargetName="SizeLabel" Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Pastille de plateforme -->
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type local:PlatformChip}">
            <ToggleButton Style="{StaticResource ChipToggle}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="Chip_Click"
                          Visibility="{Binding IsShown, Converter={StaticResource BoolToVis}}"
                          ToolTip="{Binding [ChipTip], Source={x:Static local:Loc.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" Margin="7,0,0,0" FontSize="12.5"/>
                    <TextBlock Text="{Binding Count}" Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"/>
                </StackPanel>
            </ToggleButton>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="28,22,28,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/logo.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding [HeaderTitle], Source={x:Static local:Loc.Instance}}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="StatusPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="Collapsed">
                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource SpinnerTrack}"/>
                        <Ellipse Style="{StaticResource SpinnerArc}"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" Margin="9,0,0,0" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="LanguageButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Language_Click"
                        ToolTip="{Binding [LanguageTip], Source={x:Static local:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [LanguageCode], Source={x:Static local:Loc.Instance}}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="11,7" Click="Theme_Click"
                        ToolTip="{Binding [ThemeTip], Source={x:Static local:Loc.Instance}}">
                    <TextBlock x:Name="ThemeGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE706;" FontSize="14" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="RescanButton" Style="{StaticResource SecondaryButton}" Click="Rescan_Click"
                        ToolTip="{Binding [RefreshTip], Source={x:Static local:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [Refresh], Source={x:Static local:Loc.Instance}}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Titre de section + légende -->
        <Grid Grid.Row="1" Margin="28,18,28,9">
            <TextBlock Text="{Binding [Drives], Source={x:Static local:Loc.Instance}}" Style="{StaticResource ColumnHeader}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource BarGamesBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [LegendGames], Source={x:Static local:Loc.Instance}}" Margin="6,0,14,0" FontSize="11.5"
                           Foreground="{DynamicResource TextFaintBrush}"/>
                <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource BarOtherBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [LegendOther], Source={x:Static local:Loc.Instance}}" Margin="6,0,14,0" FontSize="11.5"
                           Foreground="{DynamicResource TextFaintBrush}"/>
                <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource BarFreeBrush}"
                        BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [LegendFree], Source={x:Static local:Loc.Instance}}" Margin="6,0,0,0" FontSize="11.5"
                           Foreground="{DynamicResource TextFaintBrush}"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="DriveList" Grid.Row="2" Margin="20,0,20,0" Style="{StaticResource BareListBox}"
                 ItemContainerStyle="{StaticResource BareListBoxItem}" ItemTemplate="{StaticResource DriveCardTemplate}"
                 SelectionChanged="DriveList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Recherche, filtres, tri -->
        <Grid Grid.Row="3" Margin="28,12,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" VerticalAlignment="Top"
                     Tag="{Binding [SearchPlaceholder], Source={x:Static local:Loc.Instance}}"
                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
            <ItemsControl x:Name="PlatformChips" Grid.Column="1" Margin="14,2,14,0" VerticalAlignment="Top" Focusable="False"
                          ItemTemplate="{StaticResource ChipTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{Binding [SortBy], Source={x:Static local:Loc.Instance}}" Foreground="{DynamicResource TextFaintBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SortSize" Style="{StaticResource SegmentRadio}" GroupName="Sort" Tag="size"
                                     Content="{Binding [SortSize], Source={x:Static local:Loc.Instance}}"
                                     IsChecked="True" Checked="Sort_Checked"/>
                        <RadioButton x:Name="SortName" Style="{StaticResource SegmentRadio}" GroupName="Sort" Tag="name"
                                     Content="{Binding [SortName], Source={x:Static local:Loc.Instance}}" Checked="Sort_Checked"/>
                        <RadioButton x:Name="SortPlayed" Style="{StaticResource SegmentRadio}" GroupName="Sort" Tag="played"
                                     Content="{Binding [SortPlayed], Source={x:Static local:Loc.Instance}}" Checked="Sort_Checked"
                                     ToolTip="{Binding [SortPlayedTip], Source={x:Static local:Loc.Instance}}"/>
                        <RadioButton x:Name="SortPlatform" Style="{StaticResource SegmentRadio}" GroupName="Sort" Tag="platform"
                                     Content="{Binding [SortPlatform], Source={x:Static local:Loc.Instance}}" Checked="Sort_Checked"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- En-têtes de colonnes (alignés sur les lignes) -->
        <Grid Grid.Row="4" Margin="41,4,43,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="128"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="214"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ListCountText" Style="{StaticResource ColumnHeader}"/>
            <TextBlock Grid.Column="1" Text="{Binding [ColPlatform], Source={x:Static local:Loc.Instance}}" Style="{StaticResource ColumnHeader}"/>
            <TextBlock Grid.Column="2" Text="{Binding [ColDrive], Source={x:Static local:Loc.Instance}}" Style="{StaticResource ColumnHeader}"/>
            <TextBlock Grid.Column="3" Text="{Binding [ColPlayed], Source={x:Static local:Loc.Instance}}" Style="{StaticResource ColumnHeader}"/>
            <TextBlock Grid.Column="4" Text="{Binding [ColSize], Source={x:Static local:Loc.Instance}}" Style="{StaticResource ColumnHeader}"
                       HorizontalAlignment="Right" Margin="0,0,18,0"/>
        </Grid>

        <Grid Grid.Row="5">
            <ListBox x:Name="GameList" Margin="20,0,12,0" Style="{StaticResource BareListBox}"
                     ItemContainerStyle="{StaticResource BareListBoxItem}" ItemTemplate="{StaticResource GameRowTemplate}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                     KeyDown="GameList_KeyDown"/>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                        Margin="0,0,0,60">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7FC;" FontSize="40"
                           Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyText" Margin="0,14,0,0" Foreground="{DynamicResource TextDimBrush}" FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60">
                <Grid Width="36" Height="36" HorizontalAlignment="Center">
                    <Ellipse Style="{StaticResource SpinnerTrack}" StrokeThickness="3"/>
                    <Ellipse Style="{StaticResource SpinnerArc}" StrokeThickness="3" StrokeDashArray="9 100"/>
                </Grid>
                <TextBlock Text="{Binding [LoadingTitle], Source={x:Static local:Loc.Instance}}" Margin="0,16,0,0" FontSize="15"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Steam · Epic Games · Xbox · GOG · Ubisoft · EA · Battle.net · Rockstar · Riot · GRYPHLINK · Heroic · itch.io…"
                           Margin="0,6,0,0" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26" Padding="16,11,18,11"
                    CornerRadius="10" Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource ToastBorderBrush}"
                    BorderThickness="1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE73E;"
                               Foreground="{DynamicResource SuccessBrush}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
