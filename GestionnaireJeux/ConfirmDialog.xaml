<Window x:Class="GestionnaireJeux.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GestionnaireJeux"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Frame" Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="24,22,24,20" MouseLeftButtonDown="Frame_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="GlyphBadge" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DangerSoftBrush}">
                    <TextBlock x:Name="GlyphText" FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="&#xE74D;"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="14,0,0,0" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="MessageText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"
                       LineHeight="19"/>

            <Border x:Name="DetailsBox" Margin="0,16,0,0" Background="{DynamicResource DetailsBrush}" CornerRadius="10" Padding="14,9"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <StackPanel x:Name="DetailsPanel"/>
            </Border>

            <TextBlock x:Name="NoteText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextFaintBrush}"/>

            <Grid Margin="0,22,0,0">
                <Button x:Name="AltButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                        Click="Alt_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="96" Click="No_Click"
                            Content="{Binding [Cancel], Source={x:Static local:Loc.Instance}}"/>
                    <Button x:Name="YesButton" Style="{StaticResource DangerSolidButton}" Margin="10,0,0,0" MinWidth="120"
                            Click="Yes_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
